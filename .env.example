# 复制为 .env 后按需修改

# 监听地址与端口。0.0.0.0 表示局域网内其他设备都能访问
HOST=0.0.0.0
PORT=8080

# 本地 PostgreSQL 连接串
DATABASE_URL=postgres://mapweb:change-me@localhost:5432/mapweb

# 上传图片的存放目录（绝对路径或相对项目根目录）
UPLOAD_DIR=./data/uploads

# 可选：MapTiler key，填写后可用卫星图、卫星 + 地名等底图；留空则只使用 OpenStreetMap
# 免费申请：https://cloud.maptiler.com/account/keys/
# key 会发送到浏览器，建议在 MapTiler 后台限制允许的来源（如 raspberrypi.local、localhost）
MAPTILER_KEY=

# 足迹统计：后台把标注坐标发给 OpenStreetMap Nominatim，查询所在的国家、省、市、镇（每秒 1 次，每个标注只查一次）
# 设为 off 则不发送任何坐标，行政区统计也就不可用（世界遗产统计在本地计算，不受影响）
GEOCODER=on
# 可选：填写邮箱，Nominatim 在请求量异常时可以联系你
GEOCODER_EMAIL=
